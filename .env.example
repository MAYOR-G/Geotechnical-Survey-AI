# ==========================================
# PUBLIC / CLIENT-SAFE VARIABLES (apps/web)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ==========================================
# SERVER-ONLY SECRETS (apps/api & Next.js server)
# ==========================================
ENABLE_PASSCODE_GATE=false
APP_PASSCODE_HASH=
SESSION_SECRET_KEY=geotech-survey-ai-cupertino-studio-secret-key-2026-offshore-gems
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Defaults to local SQLite for zero-config local startup; swap to Supabase PostgreSQL for cloud)
DATABASE_URL=sqlite+aiosqlite:///./geotech_studio.db
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI & Search Providers
OPENROUTER_API_KEY=
OPENROUTER_DRAFTING_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
TAVILY_API_KEY=
